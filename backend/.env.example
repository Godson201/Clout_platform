ENVIRONMENT=development

# Postgres connection string (asyncpg driver). Matches docker-compose service "db" by default.
DATABASE_URL=postgresql+asyncpg://clout:clout@localhost:5432/clout

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-value

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

CORS_ORIGINS=["http://localhost:3000"]

DEFAULT_CURRENCY=RWF

# Bootstrap admin account, created only by `python -m app.seeds.seed` — leave unset to skip.
# Note: email-validator rejects reserved/special-use TLDs (.local, .test, .example, ...)
SEED_ADMIN_EMAIL=admin@clout-platform.com
SEED_ADMIN_PASSWORD=change-me-strong-password

# Local-filesystem stand-in for S3-compatible object storage (see app/services/storage.py).
MEDIA_ROOT=./media
MAX_VIDEO_UPLOAD_MB=200
MAX_IMAGE_UPLOAD_MB=10
MAX_AUDIO_UPLOAD_MB=20
MAX_DOCUMENT_UPLOAD_MB=20

# "bypass" is permitted only outside production. Production requires a reachable
# clamd service and MALWARE_SCANNER_MODE=clamav.
MALWARE_SCANNER_MODE=bypass
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# This backend's own publicly reachable origin (see app/services/storage.py) —
# used to build absolute URLs for uploaded media that external platform APIs
# need to fetch (e.g. TikTok PULL_FROM_URL).
PUBLIC_BASE_URL=http://localhost:8000

# Matches docker-compose's "redis" service; overridden to redis://redis:6379/... inside compose.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# true = no broker/worker needed, tasks run synchronously in-process (local dev without Docker).
# Set to false when redis + celery-worker are actually running (docker-compose sets this itself).
CELERY_TASK_ALWAYS_EAGER=true

# "mock" (default) simulates MTN MoMo synchronously with no external calls — used
# for local dev and the whole test suite. Set to "momo" once real sandbox/production
# credentials below are filled in (see app/services/payments/momo.py).
PAYMENT_PROVIDER_MODE=mock

MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_TARGET_ENVIRONMENT=sandbox
MOMO_COLLECTIONS_SUBSCRIPTION_KEY=
MOMO_COLLECTIONS_API_USER=
MOMO_COLLECTIONS_API_KEY=
MOMO_DISBURSEMENTS_SUBSCRIPTION_KEY=
MOMO_DISBURSEMENTS_API_USER=
MOMO_DISBURSEMENTS_API_KEY=
# HMAC secret MTN MoMo signs webhook callbacks with — leave unset only in mock/dev
# mode; required (enforced) the moment PAYMENT_PROVIDER_MODE=momo is real traffic.
MOMO_WEBHOOK_SECRET=

# Fernet key encrypting SocialAccount OAuth tokens at rest — required in every
# environment. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SOCIAL_TOKEN_ENCRYPTION_KEY=change-me-generate-a-real-fernet-key

# "mock" (default) simulates every platform's OAuth + publish + metrics APIs with
# no external calls. Set to "live" only once a platform's app credentials below
# are filled in AND that platform has actually granted the relevant API access —
# see app/services/social/*.py for why that's a real per-platform gate, not a switch.
SOCIAL_OAUTH_MODE=mock
FRONTEND_BASE_URL=http://localhost:3000

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

META_APP_ID=
META_APP_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# "template" (default) fills a fixed narrative from verified campaign numbers —
# always available. "anthropic" asks Claude to write a more natural narrative,
# then validates every number against the same verified data before showing it.
REPORT_GENERATOR_MODE=template
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# "mock" (default) never makes a network call — logs the email instead, used
# for local dev/tests. "smtp" sends real mail via the SMTP_* settings below.
EMAIL_MODE=mock
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=CLOUT
