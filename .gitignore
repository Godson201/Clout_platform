# Python
backend/.venv/
**/__pycache__/
*.pyc

# Env files (never commit real secrets)
.env
.env.*
!.env.example

# Node / Next.js
frontend/node_modules/
frontend/.next/
frontend/out/

# Test artifacts
.pytest_cache/
*.sqlite3
backend/test.db*

# Local dev database and uploaded media (LocalStorageBackend) — never real
